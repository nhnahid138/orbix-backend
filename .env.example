# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=orbix_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_DATABASE=orbix_store
DB_SSL=false
DB_CONNECT_TIMEOUT_MS=10000
DB_POOL_SIZE=10

# App and browser security
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Persistent directory for uploaded product images (mount durable storage in production).
UPLOADS_DIR=./uploads
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# Generate separate random secrets; never reuse these sample values.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_ISSUER=orbix-api
JWT_AUDIENCE=orbix-store

# Set both to bootstrap the first admin account, then remove them from the deployment environment.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Store Administrator

# Payments: remain disabled until EPS merchant credentials and callback URL are issued.
EPS_ENABLED=false
EPS_SANDBOX=true
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
EPS_MERCHANT_ID=
EPS_STORE_ID=
# Optional. Only required if EPS enables encrypted IPN callbacks for this merchant.
EPS_IPN_SECRET_KEY=

# Shipping price in BDT poisha. Configure based on store policy.
FLAT_SHIPPING_MINOR=0
